<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>io.github.timer-err</groupId>
        <artifactId>qml4j-parent</artifactId>
        <version>0.2.24</version>
    </parent>

    <artifactId>qml4j-demo-desktop</artifactId>

    <!-- Demo app, not a published library: never deploy it to Central.
         Inherits the parent's release=8 (Skija supports Java 8). -->
    <properties>
        <maven.deploy.skip>true</maven.deploy.skip>
        <!-- The upstream app clone the dist profiles bundle when it is on disk; -Dmcq.dir moves it. -->
        <mcq.dir>${project.basedir}/../../mcq</mcq.dir>
        <!-- Stamped into every dist jar's manifest; CI passes -Ddist.revision=<commit sha>. -->
        <dist.revision>local</dist.revision>
    </properties>

    <dependencies>
        <dependency>
            <groupId>io.github.timer-err</groupId>
            <artifactId>qml4j-core</artifactId>
        </dependency>
        <dependency>
            <groupId>io.github.humbleui</groupId>
            <artifactId>skija-shared</artifactId>
        </dependency>
        <dependency>
            <groupId>io.github.humbleui</groupId>
            <artifactId>skija-linux-x64</artifactId>
            <scope>runtime</scope>
        </dependency>

        <dependency>
            <groupId>org.lwjgl</groupId>
            <artifactId>lwjgl</artifactId>
        </dependency>
        <dependency>
            <groupId>org.lwjgl</groupId>
            <artifactId>lwjgl-glfw</artifactId>
        </dependency>
        <dependency>
            <groupId>org.lwjgl</groupId>
            <artifactId>lwjgl-opengl</artifactId>
        </dependency>

        <dependency>
            <groupId>org.lwjgl</groupId>
            <artifactId>lwjgl</artifactId>
            <classifier>${lwjgl.natives}</classifier>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>org.lwjgl</groupId>
            <artifactId>lwjgl-glfw</artifactId>
            <classifier>${lwjgl.natives}</classifier>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>org.lwjgl</groupId>
            <artifactId>lwjgl-opengl</artifactId>
            <classifier>${lwjgl.natives}</classifier>
            <scope>runtime</scope>
        </dependency>

        <!-- Test scope (declared by the parent): never shaded into the dist jar. -->
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
        </dependency>
    </dependencies>

    <build>
        <!-- No bundled QML for the runner (it's pointed at a project dir at runtime,
             DirResourceLoader). Exceptions are what the `app` mode's classpath loader
             needs and a project dir wouldn't supply: our StyleManager-driven Theme.qml
             and the engine's fonts (Material Symbols icons + Roboto). On the classpath
             for dev runs and the dist jar alike. -->
        <resources>
            <resource>
                <directory>src/main/resources</directory>
            </resource>
            <resource>
                <directory>${project.basedir}/../shared-qml/md3/Core</directory>
                <targetPath>md3/Core</targetPath>
                <includes>
                    <include>Theme.qml</include>
                </includes>
            </resource>
            <resource>
                <directory>${project.basedir}/../shared-qml/fonts</directory>
                <targetPath>fonts</targetPath>
            </resource>
        </resources>
        <!-- Everything the dist profiles share. Managed only: a build that activates no dist
             profile declares neither plugin, so neither runs. Each profile declares them bare
             and adds just its own shade artifactSet. -->
        <pluginManagement>
            <plugins>
                <!-- Bundle the upstream app source under /mcq/** and write the Controls
                     index the bundled AppResourceLoader reads (a jar entry can't be listed
                     like a directory at runtime). -->
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-antrun-plugin</artifactId>
                    <version>3.1.0</version>
                    <executions>
                        <execution>
                            <id>bundle-mcq</id>
                            <phase>prepare-package</phase>
                            <goals><goal>run</goal></goals>
                            <configuration>
                                <target xmlns:if="ant:if">
                                    <!-- Every dist profile drives the same shade execution, so two of
                                         them at once would silently emit one jar named after whichever
                                         profile Maven merged last, carrying the wrong natives. Fail
                                         instead: each dist.platform.<id> is set by exactly one profile. -->
                                    <fail message="activate exactly one dist profile: -Pdist, -Pdist-macos-arm64 or -Pdist-macos-x64">
                                        <condition>
                                            <or>
                                                <and>
                                                    <isset property="dist.platform.linux-windows-x64"/>
                                                    <or>
                                                        <isset property="dist.platform.macos-arm64"/>
                                                        <isset property="dist.platform.macos-x64"/>
                                                    </or>
                                                </and>
                                                <and>
                                                    <isset property="dist.platform.macos-arm64"/>
                                                    <isset property="dist.platform.macos-x64"/>
                                                </and>
                                            </or>
                                        </condition>
                                    </fail>
                                    <!-- The clone lives outside this repo and is not ours to
                                         redistribute, so a dist build without it must still
                                         succeed and ship no /mcq/** at all. -->
                                    <available property="mcq.present" file="${mcq.dir}/src/App" type="dir"/>
                                    <sequential if:set="mcq.present">
                                        <property name="out" value="${project.build.outputDirectory}/mcq"/>
                                        <copy todir="${out}/App">
                                            <fileset dir="${mcq.dir}/src/App"
                                                     excludes="**/CMakeLists.txt,**/*.cpp,**/*.h,**/*.rc"/>
                                        </copy>
                                        <copy todir="${out}/Core/Controls">
                                            <fileset dir="${mcq.dir}/src/Core/Controls" includes="**/*.qml"/>
                                        </copy>
                                        <copy todir="${out}/Core/Styles">
                                            <fileset dir="${mcq.dir}/src/Core/Styles"/>
                                        </copy>
                                        <fileset id="ctrls" dir="${out}/Core/Controls" includes="*.qml"/>
                                        <pathconvert property="ctrl.index" refid="ctrls" pathsep="&#10;">
                                            <mapper type="flatten"/>
                                        </pathconvert>
                                        <echo file="${out}/Core/Controls.index" message="${ctrl.index}&#10;"/>
                                    </sequential>
                                </target>
                            </configuration>
                        </execution>
                    </executions>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-shade-plugin</artifactId>
                    <version>3.5.3</version>
                    <executions>
                        <execution>
                            <id>dist-shade</id>
                            <phase>package</phase>
                            <goals><goal>shade</goal></goals>
                            <configuration>
                                <createDependencyReducedPom>false</createDependencyReducedPom>
                                <!-- Version and platform in the filename: a downloaded jar has to say
                                     what it is. Each dist profile sets dist.platform. -->
                                <finalName>qml4j-app-${project.version}-${dist.platform}</finalName>
                                <filters>
                                    <filter>
                                        <artifact>*:*</artifact>
                                        <excludes>
                                            <exclude>META-INF/*.SF</exclude>
                                            <exclude>META-INF/*.DSA</exclude>
                                            <exclude>META-INF/*.RSA</exclude>
                                            <exclude>module-info.class</exclude>
                                            <exclude>META-INF/versions/*/module-info.class</exclude>
                                        </excludes>
                                    </filter>
                                </filters>
                                <transformers>
                                    <transformer implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
                                        <mainClass>io.github.timer_err.qml4j.demo.DistMain</mainClass>
                                        <manifestEntries>
                                            <Multi-Release>true</Multi-Release>
                                            <Implementation-Title>qml4j-app</Implementation-Title>
                                            <Implementation-Version>${project.version}</Implementation-Version>
                                            <Build-Revision>${dist.revision}</Build-Revision>
                                        </manifestEntries>
                                    </transformer>
                                </transformers>
                            </configuration>
                        </execution>
                    </executions>
                </plugin>
            </plugins>
        </pluginManagement>
        <plugins>
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>exec-maven-plugin</artifactId>
                <version>3.3.0</version>
                <configuration>
                    <mainClass>io.github.timer_err.qml4j.demo.DesktopMain</mainClass>
                </configuration>
            </plugin>
            <!-- Excluded from the Central bundle (config merges with the parent's
                 release-profile plugin when -Prelease is active). -->
            <plugin>
                <groupId>org.sonatype.central</groupId>
                <artifactId>central-publishing-maven-plugin</artifactId>
                <configuration>
                    <skipPublishing>true</skipPublishing>
                </configuration>
            </plugin>
        </plugins>
    </build>

    <!-- `mvn -pl qml4j-demo-desktop -am -P<dist profile> package` builds a self-contained fat jar
         (target/qml4j-app-${project.version}-${dist.platform}.jar) that runs the bundled MD3 app:
         `dist` carries the Linux and Windows natives in one jar, `dist-macos-arm64` / `dist-macos-x64`
         one macOS arch each (the macOS JVM needs -XstartOnFirstThread, so those ship inside a tar.gz with a
         qml4j.command launcher the dist workflow generates). All are multi-release jars (Skija needs its JDK 9+ Cleanable)
         and bundle the upstream app source from ${mcq.dir} under /mcq/** when that clone is there. -->
    <profiles>
        <!-- On a non-Linux desktop, select the matching LWJGL and Skija native artifacts.
             Platform-specific launcher requirements are handled separately. -->
        <profile>
            <id>windows-dev</id>
            <activation>
                <os>
                    <family>windows</family>
                    <arch>amd64</arch>
                </os>
            </activation>
            <properties>
                <lwjgl.natives>natives-windows</lwjgl.natives>
            </properties>
            <dependencies>
                <dependency>
                    <groupId>io.github.humbleui</groupId>
                    <artifactId>skija-windows-x64</artifactId>
                    <version>${skija.version}</version>
                    <scope>runtime</scope>
                </dependency>
            </dependencies>
        </profile>
        <profile>
            <id>macos-x64-dev</id>
            <activation>
                <os>
                    <family>mac</family>
                    <arch>x86_64</arch>
                </os>
            </activation>
            <properties>
                <lwjgl.natives>natives-macos</lwjgl.natives>
            </properties>
            <dependencies>
                <dependency>
                    <groupId>io.github.humbleui</groupId>
                    <artifactId>skija-macos-x64</artifactId>
                    <version>${skija.version}</version>
                    <scope>runtime</scope>
                </dependency>
            </dependencies>
        </profile>
        <profile>
            <id>macos-arm64-dev</id>
            <activation>
                <os>
                    <family>mac</family>
                    <arch>aarch64</arch>
                </os>
            </activation>
            <properties>
                <lwjgl.natives>natives-macos-arm64</lwjgl.natives>
            </properties>
            <dependencies>
                <dependency>
                    <groupId>io.github.humbleui</groupId>
                    <artifactId>skija-macos-arm64</artifactId>
                    <version>${skija.version}</version>
                    <scope>runtime</scope>
                </dependency>
            </dependencies>
        </profile>

        <!-- The dist profiles are never auto-activated and are declared after the dev ones, so
             their lwjgl.natives wins over whatever the build host activated (last declaration of
             an active profile wins). Each sets that property explicitly rather than inheriting it,
             names the Skija native it wants, and shades out every Skija native it does not want,
             including the unconditional skija-linux-x64 base dependency. The LWJGL natives need no
             such exclude: they enter through the ${lwjgl.natives} classifier, so exactly one set
             resolves per profile. Shade-only surgery; dev/exec resolution is untouched. -->
        <profile>
            <id>dist</id>
            <properties>
                <dist.platform>linux-windows-x64</dist.platform>
                <dist.platform.linux-windows-x64>true</dist.platform.linux-windows-x64>
                <lwjgl.natives>natives-linux</lwjgl.natives>
            </properties>
            <dependencies>
                <!-- Linux natives come from the base deps; add the Windows ones so the one
                     jar runs on both. Each native loader picks its platform's lib at runtime. -->
                <dependency>
                    <groupId>io.github.humbleui</groupId>
                    <artifactId>skija-windows-x64</artifactId>
                    <version>${skija.version}</version>
                    <scope>runtime</scope>
                </dependency>
                <dependency>
                    <groupId>org.lwjgl</groupId>
                    <artifactId>lwjgl</artifactId>
                    <classifier>natives-windows</classifier>
                    <scope>runtime</scope>
                </dependency>
                <dependency>
                    <groupId>org.lwjgl</groupId>
                    <artifactId>lwjgl-glfw</artifactId>
                    <classifier>natives-windows</classifier>
                    <scope>runtime</scope>
                </dependency>
                <dependency>
                    <groupId>org.lwjgl</groupId>
                    <artifactId>lwjgl-opengl</artifactId>
                    <classifier>natives-windows</classifier>
                    <scope>runtime</scope>
                </dependency>
            </dependencies>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-antrun-plugin</artifactId>
                    </plugin>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-shade-plugin</artifactId>
                        <configuration>
                            <artifactSet>
                                <excludes>
                                    <exclude>io.github.humbleui:skija-macos-x64</exclude>
                                    <exclude>io.github.humbleui:skija-macos-arm64</exclude>
                                </excludes>
                            </artifactSet>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>
        <profile>
            <id>dist-macos-arm64</id>
            <properties>
                <dist.platform>macos-arm64</dist.platform>
                <dist.platform.macos-arm64>true</dist.platform.macos-arm64>
                <lwjgl.natives>natives-macos-arm64</lwjgl.natives>
            </properties>
            <dependencies>
                <dependency>
                    <groupId>io.github.humbleui</groupId>
                    <artifactId>skija-macos-arm64</artifactId>
                    <version>${skija.version}</version>
                    <scope>runtime</scope>
                </dependency>
            </dependencies>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-antrun-plugin</artifactId>
                    </plugin>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-shade-plugin</artifactId>
                        <configuration>
                            <artifactSet>
                                <excludes>
                                    <exclude>io.github.humbleui:skija-linux-x64</exclude>
                                    <exclude>io.github.humbleui:skija-windows-x64</exclude>
                                    <exclude>io.github.humbleui:skija-macos-x64</exclude>
                                </excludes>
                            </artifactSet>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>
        <profile>
            <id>dist-macos-x64</id>
            <properties>
                <dist.platform>macos-x64</dist.platform>
                <dist.platform.macos-x64>true</dist.platform.macos-x64>
                <!-- LWJGL's x64 macOS classifier has no arch suffix. -->
                <lwjgl.natives>natives-macos</lwjgl.natives>
            </properties>
            <dependencies>
                <dependency>
                    <groupId>io.github.humbleui</groupId>
                    <artifactId>skija-macos-x64</artifactId>
                    <version>${skija.version}</version>
                    <scope>runtime</scope>
                </dependency>
            </dependencies>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-antrun-plugin</artifactId>
                    </plugin>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-shade-plugin</artifactId>
                        <configuration>
                            <artifactSet>
                                <excludes>
                                    <exclude>io.github.humbleui:skija-linux-x64</exclude>
                                    <exclude>io.github.humbleui:skija-windows-x64</exclude>
                                    <exclude>io.github.humbleui:skija-macos-arm64</exclude>
                                </excludes>
                            </artifactSet>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>
</project>
